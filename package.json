    "@testing-library/react": "^16.3.3",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "vitest": "^3.2.7"
  }
